# ─────────────────────────────────────────────────────────────
# Orbinest Server — Environment Variables
# Copy this file to .env and fill in the values before starting.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/orbinest

# JWT secrets — minimum 32 characters each
JWT_SECRET=change-me-use-a-long-random-string-here
JWT_REFRESH_SECRET=change-me-use-another-long-random-string

# ── Server ────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── JWT Token Expiry (optional) ───────────────────────────────

JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis (optional — app runs without it) ────────────────────

REDIS_URL=redis://localhost:6379
# Set to "true" when using TLS (e.g. Upstash in production)
REDIS_TLS=false

# ── AWS S3 (optional — file uploads degrade gracefully without) ─

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Max file upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# ── CORS / Frontend ───────────────────────────────────────────

# Allowed CORS origin for browser requests
CORS_ORIGIN=http://localhost:5173

# Used for cookie domain and secure-cookie settings
FRONTEND_URL=http://localhost:5173

# Set to "true" for local dev to allow non-HTTPS cookies
FORCE_INSECURE_COOKIES=true

# ── Rate Limiting (optional) ──────────────────────────────────

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ── Performance (optional) ────────────────────────────────────

# Log queries slower than this (ms) — set to 0 to disable
SLOW_QUERY_MS=200

# ── Feature Flags (optional) ──────────────────────────────────

# Allow public self-registration on the marketing site
ENABLE_MARKETING_SELF_REGISTER=false

# Enable Content-Security-Policy headers
CSP_ENABLED=false

# ── Email / Webhook Templates (optional) ──────────────────────

# Template URL for invite acceptance — {token} is replaced
INVITE_ACCEPT_URL_TEMPLATE=http://localhost:5173/accept-invite?token={token}

# Template URL for password reset — {token} is replaced
PASSWORD_RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}

# Optional webhook URL to notify when a password reset is triggered
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_NOTIFY_TIMEOUT_MS=5000
