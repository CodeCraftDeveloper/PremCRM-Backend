# ─────────────────────────────────────────────────────────────
# Orbinest Server — Environment Variables
# Copy this file to .env and fill in the values before starting.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/orbinest

# JWT secrets — minimum 32 characters each
JWT_SECRET=change-me-use-a-long-random-string-here
JWT_REFRESH_SECRET=change-me-use-another-long-random-string

# ── Server ────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── JWT Token Expiry (optional) ───────────────────────────────

JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis (optional — app runs without it) ────────────────────

REDIS_URL=redis://localhost:6379
# Set to "true" when using TLS (e.g. Upstash in production)
REDIS_TLS=false

# ── BullMQ Queues (optional — uses REDIS_URL above) ───────────

# Key prefix in Redis (lets multiple Orbinest envs share one Redis)
BULLMQ_PREFIX=orbinest

# Per-worker concurrency (worker process only). Tune per queue once each
# domain processor lands in its phase.
WORKER_CONCURRENCY=5

# Optional health-check port for the worker process. Leave empty to disable.
WORKER_HEALTH_PORT=

# ── Google OAuth / Gmail Integration (optional until enabled) ──

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/oauth/callback

# Comma or space separated. Defaults to openid, email, profile,
# gmail.readonly, and gmail.send when left blank.
GOOGLE_GMAIL_OAUTH_SCOPES=

# 32-byte token encryption key, base64 or hex encoded.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Gmail Pub/Sub (P5-002) ────────────────────────────────────

# Pub/Sub topic that Gmail history notifications publish to. Format:
# projects/<project-id>/topics/<topic-name>. Required to start a Gmail watch.
GOOGLE_PUBSUB_TOPIC=

# Optional: comma or space separated Gmail label IDs to watch. Empty
# watches the entire mailbox.
GOOGLE_GMAIL_WATCH_LABEL_IDS=

# Shared verification token included in the Pub/Sub push URL as
# `?token=...`. Required in production for the public push endpoint to
# accept a request.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ── WhatsApp Business Cloud API (P6-001) ──────────────────────

# Shared token configured in the Meta Developer webhook verification screen.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta app secret. When set, inbound POST webhooks must include a matching
# X-Hub-Signature-256 header. Required in production.
WHATSAPP_APP_SECRET=

# Optional Graph API version used for stored account metadata and future sends.
WHATSAPP_GRAPH_API_VERSION=v20.0

# ── AWS S3 (optional — file uploads degrade gracefully without) ─

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Max file upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# ── CORS / Frontend ───────────────────────────────────────────

# Allowed CORS origin for browser requests
CORS_ORIGIN=http://localhost:5173

# Used for cookie domain and secure-cookie settings
FRONTEND_URL=http://localhost:5173

# Set to "true" for local dev to allow non-HTTPS cookies
FORCE_INSECURE_COOKIES=true

# ── Rate Limiting (optional) ──────────────────────────────────

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ── Performance (optional) ────────────────────────────────────

# Log queries slower than this (ms) — set to 0 to disable
SLOW_QUERY_MS=200

# ── AI / LLM Providers (optional — mock used by default) ───────

# Which provider backend to use: "mock" (default), "openai", "anthropic", "gemini"
AI_PROVIDER=mock

# Default model identifier for the chosen provider
AI_DEFAULT_MODEL=

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=
# Alias — some code checks GOOGLE_API_KEY
GOOGLE_API_KEY=

# ── Feature Flags (optional) ──────────────────────────────────

# Allow public self-registration on the marketing site
ENABLE_MARKETING_SELF_REGISTER=false

# Enable Content-Security-Policy headers
CSP_ENABLED=false

# ── Email / Webhook Templates (optional) ──────────────────────

# Template URL for invite acceptance — {token} is replaced
INVITE_ACCEPT_URL_TEMPLATE=http://localhost:5173/accept-invite?token={token}

# Template URL for password reset — {token} is replaced
PASSWORD_RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}

# Optional webhook URL to notify when a password reset is triggered
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_NOTIFY_TIMEOUT_MS=5000
